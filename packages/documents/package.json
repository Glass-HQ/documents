{
  "name": "@glass-hq/documents",
  "version": "0.3.0",
  "description": "Glass's document viewer and Markdown converter: parse PDF, Office, OpenDocument, EPUB, spreadsheets, images and media to Markdown and render them in the browser. Built on Firecrawl's anydoc.",
  "keywords": [
    "document",
    "docx",
    "epub",
    "markdown",
    "opendocument",
    "pdf",
    "pptx",
    "viewer",
    "webassembly",
    "xlsx"
  ],
  "homepage": "https://github.com/Glass-HQ/documents#readme",
  "bugs": {
    "url": "https://github.com/Glass-HQ/documents/issues"
  },
  "license": "MIT",
  "author": "Glass HQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glass-HQ/documents.git",
    "directory": "packages/documents"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./pdf.worker.min.mjs": "./dist/pdf.worker.min.mjs",
    "./pdf.renderer.min.mjs": "./dist/pdf.renderer.min.mjs"
  },
  "scripts": {
    "build": "node ../../scripts/build-core-wasm.mjs && rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.ts",
    "test": "vp test"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "docx-preview": "^0.4.1",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
