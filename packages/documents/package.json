{
  "name": "@glass-hq/documents",
  "version": "0.3.0",
  "description": "Parse any file to Markdown and render it in the browser: PDF, Office, OpenDocument, EPUB, spreadsheets, images, media and more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glass-HQ/documents.git",
    "directory": "packages/documents"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./pdf.worker.min.mjs": "./dist/pdf.worker.min.mjs"
  },
  "scripts": {
    "build": "node ../../scripts/build-core-wasm.mjs && rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.ts",
    "test": "vp test"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.4.0",
    "docx-preview": "^0.4.1",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
