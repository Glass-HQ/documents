{
  "name": "documents-workspace",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glass-HQ/documents.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "bench",
      "scripts",
      "tools/*",
      "wasm/www"
    ],
    "catalog": {
      "@arethetypeswrong/core": "0.18.5",
      "@types/node": "26.6.6",
      "@types/react": "19.3.0",
      "publint": "0.3.25",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
      "vite-plus": "1.6.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "release": "node scripts/release.ts",
    "dev:playground": "vp run --filter documents-playground dev"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "publint": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.4",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^26.13.1"
  }
}
